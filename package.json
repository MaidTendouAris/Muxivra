{
  "name": "muxivra",
  "version": "0.33.0",
  "description": "本地媒体处理、批量转码与字幕工作台",
  "main": "out/main/index.js",
  "author": "Muxivra contributors",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run prepare:mpv && electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "licenses": "node scripts/licenses.mjs",
    "prepare:mpv": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-mpv.ps1",
    "package:win": "npm run prepare:mpv && npm run build && npm run licenses && electron-builder --win --x64 --publish=never",
    "package:dir": "npm run prepare:mpv && npm run build && npm run licenses && electron-builder --win --x64 --dir",
    "smoke:desktop": "node scripts/desktop-smoke.mjs",
    "smoke:player": "node scripts/player-smoke.mjs",
    "smoke:player-composition": "node scripts/player-composition-smoke.mjs",
    "smoke:parameters": "node scripts/parameters-smoke.mjs",
    "smoke:ui": "node scripts/ui-smoke.mjs",
    "smoke:mcp-setup": "node scripts/mcp-setup-smoke.mjs",
    "smoke:tasks": "node scripts/task-history-smoke.mjs",
    "smoke:interaction": "node scripts/mcp-interaction-smoke.mjs",
    "smoke:subtitles": "node scripts/projects-smoke.mjs",
    "smoke:subtitle-layout": "node scripts/subtitle-layout-smoke.mjs",
    "smoke:subtitle-files": "node scripts/subtitle-files-smoke.mjs",
    "smoke:update": "node scripts/update-smoke.mjs",
    "smoke:asr": "node scripts/asr-smoke.mjs",
    "smoke:subtitle-media": "node scripts/subtitle-media-smoke.mjs",
    "smoke:subtitle-audio": "node scripts/subtitle-audio-smoke.mjs",
    "smoke:projects": "node scripts/projects-smoke.mjs",
    "smoke:asr-config": "node scripts/asr-config-smoke.mjs",
    "smoke:asr-assets": "node scripts/asr-assets-smoke.mjs",
    "smoke:asr-deployment": "node scripts/asr-deployment-smoke.mjs",
    "smoke:subtitle-mcp": "node scripts/subtitle-mcp-smoke.mjs",
    "smoke:asr-progress": "node scripts/asr-progress-smoke.mjs",
    "smoke:asr-network": "node scripts/asr-network-smoke.mjs",
    "smoke:asr-fallback": "node scripts/asr-official-fallback-smoke.mjs",
    "smoke:subtitle-tools": "node scripts/subtitle-tools-smoke.mjs",
    "smoke:source-editor": "node scripts/source-editor-smoke.mjs",
    "smoke:resources": "node scripts/resources-smoke.mjs",
    "smoke:project-lifecycle": "node scripts/project-lifecycle-smoke.mjs",
    "smoke:source-workspace": "node scripts/source-editor-workspace-smoke.mjs",
    "smoke:processing": "node scripts/processing-smoke.mjs",
    "smoke:waveform": "node scripts/subtitle-waveform-interaction-smoke.mjs",
    "smoke:colors": "node scripts/subtitle-color-smoke.mjs",
    "smoke:waveform-shortcuts": "node scripts/waveform-shortcuts-smoke.mjs",
    "smoke:mcp-sources": "node scripts/mcp-sources-smoke.mjs",
    "smoke:subtitle-selection": "node scripts/subtitle-selection-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "6.8.10",
    "koffi": "3.3.2",
    "lucide-react": "1.52.0",
    "mediainfo.js": "0.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.0.0",
    "yauzl": "^3.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^2.10.0",
    "@vitejs/plugin-react": "5.1.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "monaco-editor": "0.57.0",
    "playwright": "^1.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
